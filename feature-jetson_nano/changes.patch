+el('example').onclick=async()=>{try{const q=await api('/api/example');el('dut').value=q.dut_id;el('test').value=q.test_result.test_number;el('pins').value=(q.test_result.failing_pins||[]).map(p=>p.name).join(', ');el('tester').value=q.context.tester||'';el('program').value=q.context.program||'';el('observation').value=q.retrieval_text;el('synthetic').checked=q.synthetic===true;el('error').textContent='';}catch(e){el('error').textContent=e.message;}};
